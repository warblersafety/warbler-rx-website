ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_VERSION_ID=
VOICE_SESSION_SECRET=
VOICE_DEMO_ENABLED=true
VOICE_DAILY_LIMIT=10

# Dedicated Neon database shared by production and preview; apply lib/voice-limits.sql.
VOICE_LIMIT_DATABASE_URL=

# Deployment build verifies a dedicated mock EHR agent branch and existing Twilio number.
# Keep false in ordinary local builds; production uses true.
VOICE_EHR_PUBLISH=false
VOICE_PHONE_ENABLED=false
# Optional explicit provider pins; verified build output takes precedence.
ELEVENLABS_AGENT_BRANCH_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Optional SMS ownership verification. Partial configuration fails closed.
VOICE_PHONE_VERIFICATION_REQUIRED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
